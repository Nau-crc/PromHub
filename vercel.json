{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run db:migrate:ci && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:resource/:id",
      "destination": "/api/v1/router?resource=:resource&id=:id"
    },
    {
      "source": "/api/v1/:resource",
      "destination": "/api/v1/router?resource=:resource"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
