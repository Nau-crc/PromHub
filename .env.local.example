# ─────────────────────────────────────────────────────────────
#  Example .env.local — copy to `.env.local` and fill in.
#  In production, all of these are auto-injected by Vercel when
#  the corresponding integration is connected to the project.
#
#  For local dev: `vercel env pull .env.local` brings them down.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — set by the "Neon" integration in Vercel
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Vercel Blob — set by the "Blob" integration; used by the public
# guest-registration feature (/api/event, /api/registration).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx
